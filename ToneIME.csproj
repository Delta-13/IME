<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ToneIME</AssemblyName>
    <RootNamespace>ToneIME</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>ToneIME contributors</Authors>
    <Description>Chinese-Japanese relationship-aware translation companion for Windows and LINE.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
