<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle"
            android:textColor="#475569"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ui_language_label"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/ui_language"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <Button
            android:id="@+id/open_overlay_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/open_overlay_settings"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/overlay_privacy_note"
            android:textColor="#64748B"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/source_language_label"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/source_language"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/target_language_label"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/target_language"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/relation_label"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/relation"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/scene_label"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/scene"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <TextView
            android:id="@+id/politeness_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/politeness_default"/>

        <SeekBar
            android:id="@+id/politeness"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="4"
            android:progress="2"/>

        <TextView
            android:id="@+id/warmth_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/warmth_default"/>

        <SeekBar
            android:id="@+id/warmth"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="4"
            android:progress="2"/>

        <TextView
            android:id="@+id/directness_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/directness_default"/>

        <SeekBar
            android:id="@+id/directness"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="4"
            android:progress="2"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/source_label"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/source_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="800"
            android:minHeight="132dp"
            android:minLines="5"
            android:padding="12dp"/>

        <Button
            android:id="@+id/translate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/translate"/>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_ready"
            android:textColor="#475569"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/candidate_label"
            android:textStyle="bold"/>

        <RadioGroup
            android:id="@+id/candidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/back_translation_label"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/back_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="@string/not_available"
            android:textIsSelectable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/warnings_label"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/warnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="@string/not_available"
            android:textColor="#9A3412"
            android:textIsSelectable="true"/>

        <Button
            android:id="@+id/copy"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:enabled="false"
            android:text="@string/copy"/>

        <Button
            android:id="@+id/return_to_app"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:text="@string/return_to_app"
            android:visibility="gone"/>

        <Button
            android:id="@+id/share"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:enabled="false"
            android:text="@string/share"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_label"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/base_url"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="@string/base_url_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"/>

        <EditText
            android:id="@+id/model"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/model_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"/>

        <EditText
            android:id="@+id/api_key"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/api_key_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"/>

        <Button
            android:id="@+id/save_settings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/save_settings"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/privacy_note"
            android:textColor="#64748B"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
