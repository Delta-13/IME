<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel"
    android:clipChildren="true"
    android:elevation="12dp">

    <ScrollView
        android:id="@+id/overlay_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarStyle="insideInset">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="42dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/overlay_drag_handle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_brand_mark"
                    android:contentDescription="@string/overlay_drag"
                    android:gravity="center"
                    android:text="@string/overlay_brand_symbol"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/overlay_service_label"
                    android:textColor="@color/tone_ink"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/overlay_adjust"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_overlay_control"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/overlay_adjust"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/overlay_adjust_symbol"
                    android:textAllCaps="false"
                    android:textColor="@color/tone_accent"
                    android:textSize="18sp"/>

                <Button
                    android:id="@+id/overlay_close"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_overlay_control"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/overlay_close"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/overlay_close_symbol"
                    android:textAllCaps="false"
                    android:textColor="@color/tone_muted"
                    android:textSize="18sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/overlay_adjust_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_overlay_control"
                android:orientation="vertical"
                android:padding="11dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/overlay_display_settings"
                        android:textColor="@color/tone_ink"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/overlay_opacity_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/overlay_opacity_default"
                        android:textColor="@color/tone_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/overlay_background_opacity"
                    android:textColor="@color/tone_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <SeekBar
                    android:id="@+id/overlay_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:max="100"
                    android:min="35"
                    android:progress="90"
                    android:progressTint="@color/tone_accent"
                    android:thumbTint="@color/tone_accent"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/overlay_resize_hint"
                    android:textColor="@color/tone_muted"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/overlay_source_language_spinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner"
                    android:contentDescription="@string/source_language_label"
                    android:paddingStart="9dp"
                    android:paddingEnd="34dp"/>

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/language_arrow"
                    android:textColor="@color/tone_accent"
                    android:textStyle="bold"/>

                <Spinner
                    android:id="@+id/overlay_target_language_spinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner"
                    android:contentDescription="@string/target_language_label"
                    android:paddingStart="9dp"
                    android:paddingEnd="34dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/overlay_relation_spinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner"
                    android:contentDescription="@string/relation_label"
                    android:paddingStart="9dp"
                    android:paddingEnd="34dp"/>

                <Spinner
                    android:id="@+id/overlay_scene_spinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner"
                    android:contentDescription="@string/scene_label"
                    android:paddingStart="9dp"
                    android:paddingEnd="34dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/overlay_politeness_control"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tone_value"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_overlay_politeness"
                    android:drawablePadding="3dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/overlay_level_three"
                    android:textColor="@color/tone_accent"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/overlay_warmth_control"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tone_value"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_overlay_warmth"
                    android:drawablePadding="3dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/overlay_level_three"
                    android:textColor="@color/tone_accent"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/overlay_directness_control"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tone_value"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_overlay_directness"
                    android:drawablePadding="3dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/overlay_level_three"
                    android:textColor="@color/tone_accent"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/overlay_candidate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_overlay_control"
                android:clickable="true"
                android:ellipsize="end"
                android:enabled="false"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:maxLines="3"
                android:minHeight="54dp"
                android:paddingStart="11dp"
                android:paddingTop="8dp"
                android:paddingEnd="11dp"
                android:paddingBottom="8dp"
                android:text="@string/overlay_candidate_waiting"
                android:textColor="@color/tone_ink"
                android:textSize="12sp"/>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/overlay_resize_handle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@string/overlay_resize"
        android:gravity="bottom|end"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="3dp"
        android:text="@string/overlay_resize_symbol"
        android:textColor="@color/tone_accent"
        android:textSize="26sp"
        android:textStyle="bold"/>
</FrameLayout>
