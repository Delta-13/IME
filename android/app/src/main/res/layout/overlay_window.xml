<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel"
    android:elevation="10dp"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_drag_handle"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/overlay_drag"
            android:gravity="center"
            android:text="@string/overlay_drag_symbol"
            android:textColor="#64748B"
            android:textSize="16sp"/>

        <Spinner
            android:id="@+id/overlay_source_language_spinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/source_language_label"/>

        <TextView
            android:layout_width="24dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/language_arrow"
            android:textColor="#64748B"/>

        <Spinner
            android:id="@+id/overlay_target_language_spinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/target_language_label"/>

        <Button
            android:id="@+id/overlay_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/overlay_close"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/overlay_close_symbol"
            android:textSize="18sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/overlay_relation_spinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/relation_label"/>

        <Spinner
            android:id="@+id/overlay_scene_spinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/scene_label"/>

        <TextView
            android:id="@+id/overlay_politeness_control"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:drawableStart="@drawable/ic_overlay_politeness"
            android:drawablePadding="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/overlay_level_three"
            android:textColor="#334155"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/overlay_warmth_control"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:drawableStart="@drawable/ic_overlay_warmth"
            android:drawablePadding="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/overlay_level_three"
            android:textColor="#334155"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/overlay_directness_control"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:drawableStart="@drawable/ic_overlay_directness"
            android:drawablePadding="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/overlay_level_three"
            android:textColor="#334155"
            android:textSize="14sp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/overlay_candidate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:background="#DDE6FFFB"
        android:clickable="true"
        android:ellipsize="end"
        android:enabled="false"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="@string/overlay_candidate_waiting"
        android:textColor="#0F172A"
        android:textSize="13sp"/>
</LinearLayout>
