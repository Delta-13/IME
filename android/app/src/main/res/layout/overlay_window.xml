<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel"
    android:clipChildren="true"
    android:elevation="12dp">

    <ScrollView
        android:id="@+id/overlay_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarStyle="insideInset">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="38dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/overlay_drag_handle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_brand_mark"
                    android:contentDescription="@string/overlay_drag"
                    android:gravity="center"
                    android:text="@string/overlay_brand_symbol"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlay_service_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/overlay_service_label"
                    android:textColor="@color/tone_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/overlay_open_app"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_overlay_control"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/overlay_open_app"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/overlay_open_app_symbol"
                    android:textAllCaps="false"
                    android:textColor="@color/tone_accent"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/overlay_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_overlay_control"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/overlay_close"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/overlay_close_symbol"
                    android:textAllCaps="false"
                    android:textColor="@color/tone_muted"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_overlay_control"
                android:gravity="center_vertical"
                android:minHeight="34dp"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="12dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    android:text="●"
                    android:textColor="@color/tone_accent"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/overlay_connection_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/overlay_connection_idle"
                    android:textColor="@color/tone_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_overlay_control"
                android:minHeight="46dp"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/overlay_direction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tone_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlay_settings_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tone_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/overlay_candidate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_overlay_control"
                android:clickable="true"
                android:ellipsize="end"
                android:enabled="false"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:maxLines="5"
                android:minHeight="58dp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:text="@string/overlay_candidate_waiting"
                android:textColor="@color/tone_ink"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/overlay_resize_handle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@string/overlay_resize"
        android:gravity="bottom|end"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:text="@string/overlay_resize_symbol"
        android:textColor="@color/tone_accent"
        android:textSize="24sp"
        android:textStyle="bold" />
</FrameLayout>
